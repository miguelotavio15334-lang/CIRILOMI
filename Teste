repeat task.wait() until game:IsLoaded()
local Fluent = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/main.lua"))()
local Window = Fluent:CreateWindow({
    Title = "CiriliMinu FIXADO 🤡",
    SubTitle = "Não compra base mais",
    TabWidth = 160, Size = UDim2.fromOffset(500, 350),
    Theme = "Dark", MinimizeKey = Enum.KeyCode.End
})
local Tabs = { Main = Window:AddTab({ Title = "FARM", Icon = "home" }) }

local plr = game.Players.LocalPlayer
local Root = plr.Character:WaitForChild("HumanoidRootPart")
local baseCFrame = nil

Tabs.Main:AddButton({Title = "1 - SALVAR MINHA BASE", Callback = function()
    baseCFrame = Root.CFrame
    Fluent:Notify({Title = "Salvo!", Content = "Base salva, pode ligar o farm", Duration = 3})
end})

getgenv().Farm = false
Tabs.Main:AddToggle("Farm", {Title = "2 - AUTO ROUBAR PALHAÇO", Default = false}):OnChanged(function(v) getgenv().Farm = v end)

task.spawn(function()
    while true do task.wait(0.4)
        if getgenv().Farm and baseCFrame then
            pcall(function()
                local tool = plr.Character:FindFirstChildOfClass("Tool")
                if tool then
                    -- COM PALHAÇO -> VAI PRA BASE
                    Root.CFrame = baseCFrame + Vector3.new(0,3,0)
                else
                    -- SEM PALHAÇO -> SÓ PROMPT DE ROUBAR
                    for _,v in pairs(workspace:GetDescendants()) do
                        if v:IsA("ProximityPrompt") and v.Enabled then
                            local txt = (v.ActionText .. " " .. v.ObjectText):lower()
                            -- FILTRO PRA NÃO COMPRAR BASE
                            if txt:find("roub") or txt:find("steal") or txt:find("palha") then
                                if not txt:find("comprar") and not txt:find("buy") and not txt:find("desbloq") then
                                    local hrp = v.Parent:FindFirstChild("HumanoidRootPart") or v.Parent.Parent:FindFirstChild("HumanoidRootPart")
                                    if hrp and (hrp.Position - Root.Position).Magnitude < 400 then
                                        Root.CFrame = hrp.CFrame + Vector3.new(0,0,3)
                                        task.wait(0.2)
                                        fireproximityprompt(v)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

Fluent:Notify({Title = "Fixado!", Content = "Agora não vai mais abrir loja de comprar base", Duration = 4})
