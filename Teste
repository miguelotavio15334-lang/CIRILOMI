-- CIRILIMINU HUB - DO ZERO - SÓ ROUBA, NÃO COMPRA NADA
repeat task.wait() until game:IsLoaded()

local Fluent = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/main.lua"))()
local Window = Fluent:CreateWindow({
    Title = "Roube um Palhaço 🤡",
    SubTitle = "V1 - Sem Auto Buy",
    TabWidth = 160,
    Size = UDim2.fromOffset(480, 340),
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.End
})

local Tabs = { Main = Window:AddTab({ Title = "🤡 Roubar", Icon = "home" }) }

local plr = game.Players.LocalPlayer
local Root = plr.Character:WaitForChild("HumanoidRootPart")
local minhaBase = nil

-- 1. SALVAR BASE
Tabs.Main:AddButton({
    Title = "Salvar Minha Base",
    Description = "Fica dentro da tua base e clica",
    Callback = function()
        minhaBase = Root.CFrame
        Fluent:Notify({Title = "Base Salva!", Content = "Agora pode ligar o farm", Duration = 3})
    end
})

-- 2. AUTO ROUBAR
getgenv().Roubar = false
Tabs.Main:AddToggle("Roubar", {
    Title = "Auto Roubar Palhaço", 
    Description = "Pega e traz pra base",
    Default = false
}):OnChanged(function(v)
    getgenv().Roubar = v
    if v and not minhaBase then
        minhaBase = Root.CFrame
        Fluent:Notify({Title = "Aviso", Content = "Salvei tua base automatico", Duration = 2})
    end
end)

-- 3. KITAR
getgenv().Kitar = false
Tabs.Main:AddToggle("Kitar", {
    Title = "Kitar após roubar",
    Default = false
}):OnChanged(function(v) getgenv().Kitar = v end)

-- LOOP LIMPO - SÓ PROCURA PALHAÇO
task.spawn(function()
    while true do
        task.wait(0.4)
        if getgenv().Roubar and minhaBase then
            pcall(function()
                local char = plr.Character
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool")

                if tool then
                    -- TO COM PALHAÇO = LEVA PRA BASE
                    Root.CFrame = minhaBase + Vector3.new(0,3,0)
                    task.wait(1)
                    if getgenv().Kitar then
                        plr:Kick("Roubado com sucesso 🤡")
                    end
                else
                    -- TO SEM PALHAÇO = PROCURA UM PRA ROUBAR
                    -- Procura só modelo de palhaço no workspace
                    for _,obj in pairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") then
                            local texto = (obj.ActionText .. obj.ObjectText):lower()
                            -- SÓ ROUBA SE FOR ROUBAR
                            if texto:find("roub") then
                                local modelo = obj.Parent
                                local hrp = modelo:FindFirstChild("HumanoidRootPart") or modelo.Parent:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    local dist = (hrp.Position - Root.Position).Magnitude
                                    if dist < 500 and dist > 10 then
                                        Root.CFrame = hrp.CFrame + Vector3.new(0,0,3)
                                        task.wait(0.3)
                                        fireproximityprompt(obj)
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

Fluent:Notify({Title = "Hub Carregado!", Content = "Do zero, sem auto buy. Salva a base primeiro.", Duration = 5})
Window:SelectTab(1)
