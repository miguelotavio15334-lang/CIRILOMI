repeat task.wait() until game:IsLoaded()
local Fluent = loadstring(game:HttpGet("https://raw.githubusercontent.com/dawid-scripts/Fluent/master/main.lua"))()
local Window = Fluent:CreateWindow({
    Title = "CiriliMinu ANTI-BUY",
    SubTitle = "Não compra mais nada",
    TabWidth = 160, Size = UDim2.fromOffset(500, 350),
    Theme = "Dark", MinimizeKey = Enum.KeyCode.End
})
local Tabs = { Main = Window:AddTab({ Title = "FARM", Icon = "home" }) }

local plr = game.Players.LocalPlayer
local Root = plr.Character:WaitForChild("HumanoidRootPart")
local baseCFrame = nil

Tabs.Main:AddButton({Title = "1 - SALVAR BASE", Callback = function()
    baseCFrame = Root.CFrame
    Fluent:Notify({Title = "Salvo!", Content = "Base salva", Duration = 2})
end})

getgenv().Farm = false
Tabs.Main:AddToggle("Farm", {Title = "ROUBAR PALHAÇO (SEM COMPRAR)", Default = false}):OnChanged(function(v) getgenv().Farm = v end)

-- LISTA NEGRA DE COISA QUE NÃO PODE ROUBAR
local BLACKLIST = {"base", "desbloq", "comprar", "buy", "unlock", "porta", "door", "cash", "moeda"}

task.spawn(function()
    while true do task.wait(0.5)
        if getgenv().Farm and baseCFrame then
            pcall(function()
                if plr.Character:FindFirstChildOfClass("Tool") then
                    Root.CFrame = baseCFrame + Vector3.new(0,4,0)
                else
                    -- PROCURA SÓ O PALHAÇO NO CHÃO, NÃO O BOTÃO DE COMPRAR BASE
                    for _,v in pairs(workspace:GetDescendants()) do
                        if v.Name == "Palhaço" or v.Name == "Clown" or v.Name:lower():find("clown") then
                            local hrp = v:FindFirstChild("HumanoidRootPart") or v.Parent:FindFirstChild("HumanoidRootPart")
                            if hrp and (hrp.Position - Root.Position).Magnitude < 300 and v.Parent:FindFirstChildOfClass("ProximityPrompt") then
                                local prompt = v.Parent:FindFirstChildOfClass("ProximityPrompt")
                                -- VERIFICA SE NÃO É LOJA
                                local isShop = false
                                for _,b in pairs(BLACKLIST) do
                                    if prompt.ObjectText:lower():find(b) or prompt.ActionText:lower():find(b) then
                                        isShop = true
                                    end
                                end
                                if not isShop then
                                    Root.CFrame = hrp.CFrame + Vector3.new(0,0,3)
                                    task.wait(0.3)
                                    fireproximityprompt(prompt)
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

