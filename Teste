task.spawn(function()
    while true do
        task.wait(0.2)
        pcall(function()
            for _,gui in pairs(game:GetService("CoreGui"):GetDescendants()) do
                if gui:IsA("TextLabel") and gui.Text:find("Você precisa de") then
                    gui.Parent.Parent:Destroy()
                end
            end
            -- fecha gui de comprar item do Roblox
            local purchase = game:GetService("CoreGui"):FindFirstChild("PurchasePromptApp")
            if purchase then purchase:FindFirstChild("PurchasePrompt"):Destroy() end
        end)
    end
end)

